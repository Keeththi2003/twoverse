<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Twoverse" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- System splash (core-splashscreen); matches the custom Splash background so there is no flash (FR-ONB-1). -->
    <style name="Theme.Twoverse.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Twoverse</item>
    </style>
</resources>
